# StudyGO API ? environment configuration example.
# Copy to .env and fill in real values. Never commit .env.

# Runtime environment: development | production | test
NODE_ENV=development
PORT=3001

# PostgreSQL connection string (Neon).
# Neon example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Enable TLS for the database connection (required by Neon).
DATABASE_SSL=true
# Neon's pooled endpoints present a certificate chain that Node may not trust
# by default; set to true only if you provide a trusted CA setup.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# JWT access tokens (short-lived). REQUIRED in every environment.
# The API refuses to start when this is missing, empty, a known insecure
# placeholder, or shorter than 32 characters. Generate a random value, e.g.:
#   openssl rand -base64 48
# Never commit it and never reuse it as ADMIN_PASSWORD.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Opaque refresh tokens are stored hashed; this only controls their lifetime.
JWT_REFRESH_EXPIRES_IN=7d

# CORS: comma-separated list of allowed origins for the mobile/admin frontends.
CORS_ORIGINS=

# Optional SMTP (enables password-reset emails). Leave empty to disable.
# When disabled, forgot-password still succeeds but no email is sent (logged warning).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# One-time initial System Admin bootstrap (BOTH must be set to enable it).
# At startup, if no ADMIN account exists, an ADMIN is created with this email
# and password (bcrypt). The credential may never reuse JWT_ACCESS_SECRET and
# must satisfy the account password policy. After the first successful startup,
# REMOVE these two vars from the environment; a leftover flag is harmless
# because an existing ADMIN makes bootstrap a permanent no-op.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional NestJS Observe telemetry (https://observe.nestjs.com).
# When unset, telemetry is disabled.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=study-go-api
