# StudyGO API — environment configuration example.
# Copy to .env and fill in real values. Never commit .env.

# Runtime environment: development | production | test
NODE_ENV=development
PORT=3001

# PostgreSQL connection string (Neon).
# Neon example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Enable TLS for the database connection (required by Neon).
DATABASE_SSL=true
# Neon's pooled endpoints present a certificate chain that Node may not trust
# by default; set to true only if you provide a trusted CA setup.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# JWT access tokens (short-lived).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
# Opaque refresh tokens are stored hashed; this only controls their lifetime.
JWT_REFRESH_EXPIRES_IN=7d

# CORS: comma-separated list of allowed origins for the mobile/admin frontends.
CORS_ORIGINS=

# Optional SMTP (enables password-reset emails). Leave empty to disable.
# When disabled, forgot-password still succeeds but no email is sent (logged warning).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# First admin bootstrap for `npm run seed` (optional).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional NestJS Observe telemetry (https://observe.nestjs.com).
# When unset, telemetry is disabled.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=study-go-api
